{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huajiexiewenfeng/superpowers/schemas/capability-profile.schema.json",
  "title": "Superpowers capability profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "intended_profile",
    "bindings",
    "missing_bindings",
    "baseline",
    "approval",
    "invalidation_triggers",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["not_evaluated", "evaluated", "approved", "invalidated"] },
    "intended_profile": { "enum": ["frontier", "standard", "restricted"] },
    "bindings": {
      "type": "object",
      "required": [
        "base_model",
        "reasoning_configuration",
        "harness_and_router",
        "toolchain",
        "permissions",
        "benchmark_suite",
        "evaluation_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "base_model": { "$ref": "#/$defs/binding" },
        "reasoning_configuration": { "$ref": "#/$defs/binding" },
        "harness_and_router": { "$ref": "#/$defs/binding" },
        "toolchain": { "$ref": "#/$defs/binding" },
        "permissions": { "$ref": "#/$defs/binding" },
        "benchmark_suite": { "$ref": "#/$defs/binding" },
        "evaluation_commit": { "$ref": "#/$defs/binding" }
      }
    },
    "missing_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "base_model",
          "reasoning_configuration",
          "harness_and_router",
          "toolchain",
          "permissions",
          "benchmark_suite",
          "evaluation_commit"
        ]
      }
    },
    "baseline": {
      "type": "object",
      "required": ["upstream_commit", "fork_baseline_commit"],
      "additionalProperties": false,
      "properties": {
        "upstream_commit": { "$ref": "#/$defs/commit" },
        "fork_baseline_commit": { "$ref": "#/$defs/commit" }
      }
    },
    "approval": {
      "type": "object",
      "required": ["state", "approved_by", "approved_at"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["pending", "approved", "revoked"] },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "invalidation_triggers": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "binding": {
      "type": ["object", "string", "null"]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "approved" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "missing_bindings": { "maxItems": 0 },
          "bindings": {
            "properties": {
              "base_model": { "not": { "type": "null" } },
              "reasoning_configuration": { "not": { "type": "null" } },
              "harness_and_router": { "not": { "type": "null" } },
              "toolchain": { "not": { "type": "null" } },
              "permissions": { "not": { "type": "null" } },
              "benchmark_suite": { "not": { "type": "null" } },
              "evaluation_commit": { "not": { "type": "null" } }
            }
          },
          "approval": {
            "properties": {
              "state": { "const": "approved" },
              "approved_by": { "type": "string", "minLength": 1 },
              "approved_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "not_evaluated" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": { "state": { "const": "pending" } }
          }
        }
      }
    }
  ]
}
